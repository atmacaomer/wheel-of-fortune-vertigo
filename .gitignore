# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE files
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Builds (APK goes to GitHub Releases, not the repo)
*.apk
/Builds/
*.aab
*.unitypackage
*.app

# Plastic / Unity Version Control
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Office lock files
~$*

# Case brief from Vertigo (not ours to publish)
/Vertigo_Games_Game_Developer_Demo_2026.docx

# OS
.DS_Store
Thumbs.db

# Raw case assets (already imported under Assets/_Project/Art)
/demo_content/

# Unity temp tooling folder
/.utmp/

# Local working notes (not part of the deliverable)
/CLAUDE.md
/ROADMAP.md
